{
  "schemaVersion": 1,
  "imageTarget": {
    "os": "Debian 12 Bookworm",
    "node": "22.x",
    "python": "3.11.x",
    "browser": "Playwright Chromium headless shell",
    "office": "LibreOffice from Debian Bookworm"
  },
  "shared": {
    "system": [
      "python3",
      "python3-pip",
      "zip",
      "unzip",
      "poppler-utils",
      "fonts-dejavu",
      "fonts-liberation",
      "fonts-noto-core",
      "fonts-noto-cjk",
      "fonts-noto-color-emoji"
    ],
    "contract": "Dependencies are installed before agent startup. Replacement skill downloads remain forbidden."
  },
  "profiles": {
    "artifact-taste": {
      "python": [
        { "name": "Pillow", "version": "12.3.0", "purpose": "contact sheet in preview.py (page images still render without it)", "optional": true }
      ],
      "system": ["poppler-utils", "libreoffice-core", "libreoffice-writer", "libreoffice-calc", "libreoffice-impress"]
    },
    "pdf": {
      "python": [
        { "name": "pypdf", "version": "6.15.0", "purpose": "inspection, manipulation and the check command" },
        { "name": "Pillow", "version": "12.3.0", "purpose": "image dimensions and normalization", "optional": true },
        { "name": "matplotlib", "version": "3.11.1", "purpose": "optional chart images until DOCX has an SVG chart recipe; PDF charts are inline SVG", "optional": true }
      ],
      "node": [
        { "name": "playwright", "version": "1.62.1", "purpose": "HTML/CSS to PDF: the only PDF route, for every language" }
      ],
      "system": ["poppler-utils"],
      "browser": ["chromium-headless-shell"]
    },
    "pptx": {
      "node": [
        { "name": "pptxgenjs", "version": "4.0.1", "purpose": "authoring" }
      ],
      "system": ["libreoffice-core", "libreoffice-impress"]
    },
    "xlsx": {
      "python": [
        { "name": "XlsxWriter", "version": "3.2.9", "purpose": "authoring" },
        { "name": "openpyxl", "version": "3.1.5", "purpose": "read-only analysis and QA" },
        { "name": "pandas", "version": "3.0.5", "purpose": "analysis" }
      ],
      "system": ["libreoffice-core", "libreoffice-calc"]
    },
    "docx": {
      "node": [
        { "name": "docx", "version": "9.7.1", "purpose": "authoring" }
      ],
      "python": [
        { "name": "pypdf", "version": "6.15.0", "purpose": "page count and page fill in the check" }
      ],
      "system": ["libreoffice-core", "libreoffice-writer"]
    }
  }
}
