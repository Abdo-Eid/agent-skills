{
  "schemaVersion": 1,
  "imageTarget": {
    "os": "Debian 13 Trixie",
    "node": "22.x",
    "python": "3.12.x, from the python:3.12-slim-trixie base; apt adds no other",
    "browser": "Playwright Chromium headless shell",
    "office": "Headless LibreOffice 26.8 from trixie-backports"
  },
  "shared": {
    "system": [
      "zip",
      "unzip",
      "poppler-utils",
      "fonts-dejavu",
      "fonts-liberation",
      "fonts-liberation-sans-narrow",
      "fonts-noto-core",
      "fonts-noto-cjk",
      "fonts-noto-color-emoji"
    ],
    "contract": "Dependencies are installed before agent startup. Replacement skill downloads remain forbidden."
  },
  "profiles": {
    "artifact-taste": {
      "python": [
        { "name": "Pillow", "version": "13.0.0", "purpose": "contact sheet in preview.py (page images still render without it)", "optional": true }
      ],
      "node": [
        { "name": "playwright", "version": "1.62.1", "purpose": "image.cjs renders an HTML or SVG file to a PNG, with the Chromium headless shell", "optional": true }
      ],
      "system": ["poppler-utils", "libreoffice-writer-nogui", "libreoffice-calc-nogui", "libreoffice-impress-nogui"]
    },
    "pdf": {
      "python": [
        { "name": "pypdf", "version": "6.21.4", "purpose": "inspection, manipulation and the check command" },
        { "name": "Pillow", "version": "13.0.0", "purpose": "image dimensions and normalization", "optional": true },
        { "name": "matplotlib", "version": "3.11.1", "purpose": "optional chart images until DOCX has an SVG chart recipe; PDF charts are inline SVG", "optional": true }
      ],
      "node": [
        { "name": "playwright", "version": "1.62.1", "purpose": "HTML/CSS to PDF: the only PDF route, for every language" }
      ],
      "system": ["poppler-utils"],
      "browser": ["chromium-headless-shell"]
    },
    "pptx": {
      "node": [
        { "name": "pptxgenjs", "version": "4.0.1", "purpose": "authoring" }
      ],
      "system": ["libreoffice-impress-nogui"]
    },
    "xlsx": {
      "python": [
        { "name": "XlsxWriter", "version": "3.2.9", "purpose": "authoring" },
        { "name": "openpyxl", "version": "3.1.5", "purpose": "read-only analysis and QA" },
        { "name": "pandas", "version": "3.0.5", "purpose": "analysis" }
      ],
      "system": ["libreoffice-calc-nogui"]
    },
    "docx": {
      "node": [
        { "name": "docx", "version": "9.15.0", "purpose": "authoring" }
      ],
      "python": [
        { "name": "pypdf", "version": "6.21.4", "purpose": "page count and page fill in the check" }
      ],
      "system": ["poppler-utils", "libreoffice-writer-nogui"]
    }
  }
}
